transactions_analytics:
  target: dev
  outputs:
    dev:
      type: clickhouse
      schema: transactions_db
      host: "{{ env_var('CLICKHOUSE_HOST', 'localhost') }}"
      port: "{{ env_var('CLICKHOUSE_PORT', '8123') | int }}"
      user: "{{ env_var('CLICKHOUSE_USER', 'dbt') }}"
      password: "{{ env_var('CLICKHOUSE_PASSWORD', 'dbt') }}"
      secure: false
      threads: 4
      connect_timeout: 10
      send_receive_timeout: 300
